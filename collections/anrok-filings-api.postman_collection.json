                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"jurisId\": \"<string>\",\n    \"periodEndDateRangeInclusive\": \"<string>\"\n  },\n  \"limit\": 10,\n  \"cursor\": \"<string>\"\n}",
