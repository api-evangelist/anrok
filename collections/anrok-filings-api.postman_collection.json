          "request": {
            "name": "List filings",
            "description": {
              "content": "Lists filings in Anrok. These can be filtered by the jurisdiction ID and the filing period end date.\nThis endpoint is a premium feature. Please contact hello@anrok.com for more information to enable this on your seller account.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "seller",
                "filings",
                "list"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
