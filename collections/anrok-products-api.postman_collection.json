  "item": [
    {
      "id": "25107d24-3462-4f3f-a9a3-c1db08d15473",
      "name": "Products",
      "description": {
        "content": "The Anrok Products API endpoints allow you to manage the products on your seller\naccount. Each product is identified by an external ID and is assigned a product tax category\n(PTC) which determines the product's taxability in each jurisdiction.\nPTCs may be one of Anrok's standard PTCs or a custom PTC that has been created on your seller account.\n",
        "type": "text/plain"
      },
