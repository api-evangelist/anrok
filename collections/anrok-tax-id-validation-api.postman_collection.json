              "body": "{\n  \"jurises\": [\n    {\n      \"name\": \"Canada (federal)\",\n      \"taxIdNames\": {\n        \"name\": \"GST/HST account number\",\n        \"abbreviation\": null\n      },\n      \"validTaxIds\": [\n        {\n          \"value\": \"123456789\"\n        }\n      ]\n    },\n    {\n      \"name\": \"Quebec\",\n      \"taxIdNames\": {\n        \"name\": \"QST registration number\",\n        \"abbreviation\": null\n      },\n      \"validTaxIds\": [\n        {\n          \"value\": \"987654321\"\n        }\n      ]\n    }\n  ]\n}",
