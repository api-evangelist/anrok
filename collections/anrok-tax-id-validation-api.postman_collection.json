                  "raw": "{\n  \"customerAddress\": {\n    \"country\": \"CA\",\n    \"line1\": \"123 Main St\",\n    \"city\": \"Quebec City\",\n    \"region\": \"Quebec\",\n    \"postalCode\": \"G1P 2J6\"\n  },\n  \"customerTaxIds\": [\n    {\n      \"value\": \"123456789\"\n    },\n    {\n      \"value\": \"987654321\"\n    }\n  ]\n}",
                  "options": {
