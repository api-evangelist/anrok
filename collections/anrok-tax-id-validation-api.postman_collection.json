  "item": [
    {
      "id": "1de0e224-03ce-402e-a2b2-c3da7765c56f",
      "name": "Tax ID validation",
      "description": {
        "content": "**The Anrok Tax ID Validation endpoint is a premium feature. Please contact hello@anrok.com for more information to enable this on your Anrok seller account.**\n\n\n1. Pass a customer address and an empty array of customerTaxIds:\n\t- Anrok verifies the customer address is valid for tax calculation.\n\t- Anrok responds with the list of customer tax IDs to collect.\n1. Collect the customer tax IDs and call the API endpoint again to validate them:\n\t- Anrok provides a list of valid tax IDs for each applicable jurisdiction.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e44d70fc-4b65-40b8-8ae8-30af3afc96c3",
          "name": "Validate tax IDs",
          "request": {
            "name": "Validate tax IDs",
            "description": {
              "content": "This endpoint is used to assist in the collection and validation of customer tax IDs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "seller",
                "taxId",
                "validate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerAddress\": {\n    \"country\": \"<string>\",\n    \"line1\": \"<string>\",\n    \"city\": \"<string>\",\n    \"region\": \"<string>\",\n    \"postalCode\": \"<string>\"\n  },\n  \"customerTaxIds\": [\n    {\n      \"value\": \"<string>\"\n    },\n    {\n      \"value\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
